---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="This page does not exist."
  noindex
>
  <section class="mx-auto flex max-w-6xl flex-1 flex-col items-start px-4 py-12 sm:px-6 sm:py-16">
    <p class="font-mono text-sm tracking-wide text-[var(--accent)]">404</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--fg)] sm:text-4xl">
      Page not found
    </h1>
    <p class="mt-4 max-w-md text-[var(--fg-muted)]">
      The page you requested does not exist or has been moved.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn-primary">Home</a>
      <a href="/docs/guide/introduction" class="btn-secondary">Docs</a>
    </div>
  </section>
</BaseLayout>
