---
import { getCollection } from 'astro:content';
import DocPage from '../../components/DocPage.astro';
import { defaultLocale } from '../../i18n/config';
import { docIdentity } from '../../lib/docs';

export async function getStaticPaths() {
  const docs = await getCollection('docs', (doc) => docIdentity(doc).locale === defaultLocale);
  return docs.map((doc) => ({
    params: { slug: docIdentity(doc).slug },
    props: { doc },
  }));
}

const { doc } = Astro.props;
---

<DocPage doc={doc} />

