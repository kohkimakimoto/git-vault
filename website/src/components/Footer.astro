---
import type { Locale } from '../i18n/config';
import { getMessages } from '../i18n/utils';
interface Props { locale: Locale }
const messages = getMessages(Astro.props.locale);
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-[var(--border)]">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-8 text-sm text-[var(--fg-muted)] sm:flex-row sm:items-start sm:justify-between sm:px-6">
    <div class="space-y-2">
      <p>
        <span class="font-medium text-[var(--fg)]">git-vault</span>
        <span class="mx-2 text-[var(--border)]">·</span>
        {messages.common.license}
      </p>
      <p>
        <span class="text-[var(--fg-muted)]">{messages.common.relatedProjects}:</span>
        {' '}
        <a
          href="https://git-artifact.kohkimakimoto.dev"
          class="font-medium text-[var(--fg)] underline-offset-2 hover:text-[var(--accent)] hover:underline"
        >
          git-artifact
        </a>
      </p>
    </div>
    <p>© {year} Kohki Makimoto</p>
  </div>
</footer>
