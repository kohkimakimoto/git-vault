---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Locale } from '../i18n/config';
import { getMessages, localizedPath } from '../i18n/utils';
interface Props { locale: Locale }
const { locale } = Astro.props;
const messages = getMessages(locale);
---

<BaseLayout title={messages.notFound.title} description={messages.notFound.description} locale={locale} noindex>
  <section class="mx-auto flex max-w-6xl flex-1 flex-col items-start px-4 py-12 sm:px-6 sm:py-16">
    <p class="font-mono text-sm tracking-wide text-[var(--accent)]">404</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-[var(--fg)] sm:text-4xl">{messages.notFound.title}</h1>
    <p class="mt-4 max-w-md text-[var(--fg-muted)]">{messages.notFound.message}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={localizedPath(locale)} class="btn-primary">{messages.common.home}</a>
      <a href={localizedPath(locale, '/docs/guide/introduction')} class="btn-secondary">{messages.common.docs}</a>
    </div>
  </section>
</BaseLayout>
