---
import { languages, locales, type Locale, type LanguageAlternate } from '../i18n/config';
import { getMessages } from '../i18n/utils';

interface Props { locale: Locale; alternates: LanguageAlternate[] }
const { locale, alternates } = Astro.props;
const messages = getMessages(locale);
---

<label class="relative inline-flex h-9 items-center text-[var(--fg)]">
  <span class="sr-only">{messages.common.language}</span>
  <svg
    viewBox="0 0 24 24"
    class="pointer-events-none absolute left-2.5 hidden h-4 w-4 sm:block"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c5 5 5 13 0 18-5-5-5-13 0-18z" />
  </svg>
  <select
    data-language-picker
    class="h-full cursor-pointer appearance-none rounded-md border border-[var(--border)] bg-[var(--bg-elevated)] py-0 pl-2.5 pr-8 text-sm transition hover:border-[var(--navy)] focus-visible:outline-2 focus-visible:outline-[var(--accent)] sm:pl-8"
  >
    {locales.map((code) => {
      const alternate = alternates.find((entry) => entry.locale === code);
      return <option value={alternate?.href ?? ''} selected={code === locale} disabled={!alternate} lang={code}>
        {languages[code]}{!alternate ? ` (${messages.common.untranslated})` : ''}
      </option>;
    })}
  </select>
  <svg
    viewBox="0 0 24 24"
    class="pointer-events-none absolute right-2 h-3.5 w-3.5 text-[var(--fg-muted)]"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</label>

<script>
  document.querySelectorAll<HTMLSelectElement>('[data-language-picker]').forEach((picker) => {
    const currentValue = picker.value;
    picker.addEventListener('change', () => {
      if (!picker.value) return;
      const target = new URL(picker.value, window.location.origin);
      target.search = window.location.search;
      target.hash = window.location.hash;
      // Keep the current page's selection when restored from browser history.
      picker.value = currentValue;
      window.location.assign(target.href);
    });
  });
</script>
