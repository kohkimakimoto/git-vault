---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CodeCopy from '../components/CodeCopy';
import { defaultLocale, locales, type Locale, type LanguageAlternate } from '../i18n/config';
import { getMessages, localizedPath, publicPath } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  locale: Locale;
  alternates?: LanguageAlternate[];
}

const {
  title,
  locale,
  description = getMessages(locale).common.description,
  noindex = false,
  alternates = locales.map((code) => ({ locale: code, href: localizedPath(code, Astro.url.pathname) })),
} = Astro.props;
const pageTitle = title === 'git-vault' ? title : `${title} · git-vault`;
const siteName = 'git-vault';
// build.format "file" emits *.html; public URLs drop the extension (and index.html → /).
const canonicalURL = new URL(publicPath(Astro.url.pathname), Astro.site);
const defaultAlternate = alternates.find((entry) => entry.locale === defaultLocale);
const ogImageURL = new URL('/og.png', Astro.site);
const ogImageAlt = `${siteName} — ${description}`;
const ogLocaleByLang: Record<Locale, string> = { en: 'en_US', ja: 'ja_JP' };
const ogLocale = ogLocaleByLang[locale];
const messages = getMessages(locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    {!noindex && alternates.map((entry) => <link rel="alternate" hreflang={entry.locale} href={new URL(entry.href, Astro.site)} />)}
    {!noindex && defaultAlternate && <link rel="alternate" hreflang="x-default" href={new URL(defaultAlternate.href, Astro.site)} />}
    {!noindex && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    {locales.filter((code) => code !== locale).map((code) => (
      <meta property="og:locale:alternate" content={ogLocaleByLang[code]} />
    ))}
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var dark =
            stored === 'dark' ||
            (stored !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.classList.toggle('dark', dark);
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <Header locale={locale} alternates={alternates} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <CodeCopy client:load messages={messages.common} />
  </body>
</html>



