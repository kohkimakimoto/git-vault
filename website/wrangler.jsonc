{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "git-vault",
  "compatibility_date": "2026-11-07",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "git-vault.kohkimakimoto.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash"
  }
}
