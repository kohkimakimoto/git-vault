#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Store age-encrypted files in a separate Git branch."""

import argparse
from contextlib import contextmanager
from dataclasses import dataclass
import difflib
import json
import os
from pathlib import Path
import re
import shutil
import signal
import subprocess
import sys
import tempfile

VERSION = "0.11.0"

DEFAULT_SKILL_PATH = ".agents/skills/git-vault/SKILL.md"

VAULT_README = """# Vault branch

This branch is managed by [git-vault](https://github.com/kohkimakimoto/git-vault).
It is an orphan branch used only to store encrypted secret files and the recipient public keys used to encrypt them.

Do not put application code here. Use `git vault` to read and update this branch; editing its contents by hand can break the vault.
"""

VAULT_README_NAME = "README.md"

SKILL_CONTENT = """---
name: git-vault
description: Save and restore encrypted project files with git-vault, including profiles, recipients, and working branches for pull requests. Use when a project uses git-vault or the user asks to manage files with git vault.
---

# git-vault

Use `git vault` to manage encrypted files on a separate Git branch. Python 3.11+, Git, and age are required. Options follow the operation: `git vault <command> -h`.

Official repository: https://github.com/kohkimakimoto/git-vault

Use its [README](https://github.com/kohkimakimoto/git-vault#readme) for documentation and [source code](https://github.com/kohkimakimoto/git-vault/blob/main/bin/git-vault) when behavior needs clarification.

## Check availability

```sh
git vault version
```

If git-vault is missing from PATH, consult the official [installation instructions](https://github.com/kohkimakimoto/git-vault#installation), research options for the user's environment, and propose commands. Install only when that is within the user's requested scope; otherwise wait. If the documentation cannot be reached, say so instead of inventing steps. After install or repair, confirm `git vault version` before continuing.

## Choose the target

Default branch `vault`, default profile `default`. Each profile is a root directory with public keys at `<profile>/recipients.json` and ciphertext at `<profile>/files/<original-path>`. The branch root `README.md` explains the vault. A recipient is one age public key. Before updating an existing vault, inspect it:

```sh
git vault profile list
git vault list -p production
git vault recipient list -p production
```

Use the profile and branch requested by the user or established by the project; do not infer production from a filename. Paths are relative to the current directory. Prefer explicit paths when the task concerns only some files.

## Save files

```sh
git vault save -p production -m "Update application secrets" -- .env
```

Creates a local commit on the selected branch and keeps source plaintext. Unspecified files are kept. Use `-b NAME` to update an existing working branch.

For a pull-request workflow:

```sh
git vault save -p production -b vault-update-secrets -n -B origin/vault -- .env
git vault save -p production -b vault-update-secrets -- credentials.json
```

`-n` requires an explicit `-b` and rejects an existing branch. `-B` requires `-n` and defaults to local `vault`; fetch `origin/vault` first. Prefer names such as `vault-update-secrets` (Git cannot have both `vault` and `vault/update-secrets`). A branch checked out in any worktree cannot be updated.

`save -a` re-saves every registered path in the profile. Use it only when the task calls for the entire profile; a missing source fails the operation. Commit messages are public. Omit `-m` for a generated `git-vault:` message; never put secret values in a message.

## Age identity files

`age-keygen` writes an identity file like:

```
# created: 2026-10-17T21:53:43+09:00
# public key: age19438ccrwjqpmjhjpvp40aclyjnpllhgru62uak84knzs5n4k3y6q6ej2tq
AGE-SECRET-KEY-14S4CNP040N60QYYWSMGQ2225PSWKSHRCFRSW6954MY2XHC2T9U4QNV05FQ
```

The `AGE-SECRET-KEY-...` line is the private key. The `# public key: age...` comment is the matching public key. Use that public key with `-r` / recipients. Decrypt with `-i PATH`, or `-i -` for stdin. When `-i` is omitted, use `git config vault.identity` (`$GIT_COMMON_DIR` / `$TOPLEVEL` placeholders; prefer a user-global `$GIT_COMMON_DIR/vaultkey.age`). Prefer one passphrase-protected identity per clone (`age-keygen | age -p > .git/vaultkey.age`): if the key file is left behind, it still cannot be used without the passphrase, and local automation such as AI agents is less likely to unlock it unintentionally. Hand only the public key to a repository administrator. If a clone must be removed while the identity is still needed, move or back up `.git/vaultkey.age` and reuse it in the next clone; generate a new identity and register its public key only when the file is already gone. For CI, use a separate plaintext identity registered only on the profiles the job needs. Multiple age secrets belong in one identity file. Do not combine `-i -` with `-R -`. Never read, print, or pass the private key in conversation or command arguments.

## Restore files

```sh
git vault restore -p production -i /path/to/identity -- .env
git vault restore -p production -i - -- .env < /path/to/identity
```

Select the identity with `-i` or `vault.identity`. Prefer file input for noninteractive agent execution.

Restore writes plaintext with mode `0600`. Do not print restored secrets; inspect names and command success when contents are unnecessary. `restore -a` restores the whole profile. `--revision REV` restores a historical commit reachable from the selected branch.

Existing files and tracked paths are rejected by default. Use `restore -f` only when overwriting the destination is within the user's requested scope. `save -f` permits tracked input and reads working-tree content. Do not add `-f` just to bypass an unexpected failure; inspect the reported path first.

## Diff and clean working-tree plaintext

`git vault diff` compares working-tree plaintext to the latest saved snapshot (unified diff on stdout). `git vault clean` deletes that plaintext. Both need an identity (`-i` or `vault.identity`) except `clean -f`. Default `clean` compares every existing selected path to the tip first; if any differs, it prints those diffs and exits without deleting. Matching files are deleted; missing paths are reported as absent. `clean -f` deletes unconditionally. Unified diffs contain secrets: show them to the user or use them locally; do not paste them into chat.

Prefer lasting `restore` for day-to-day development. Deploy and similar short-lived jobs often need production secrets whose leakage is high risk, so keep plaintext on disk only while the job runs: restore only what it needs, run the command, then `clean`:

```sh
git vault restore -p production -f .env
./deploy.sh
git vault clean -p production -f .env
```

## Initialize, organize, and rotate recipients

Only initialize when the task calls for a new vault. Prefer an existing `origin/vault` over creating an independent vault:

```sh
git branch --track vault origin/vault
```

For a new vault or profile, obtain the intended age public keys from the user or project context.

```sh
git vault init -r age...
git vault init -R teammates.txt -l laptop
git vault profile add production -r age...
git vault recipient add -p production -i /path/to/identity -r age...
git vault recipient remove -p production -i /path/to/identity -r age...
git vault remove -p production -- .env
git vault profile remove production
```

Provide recipients with `-r` or `-R` (not both). Optional `-l` labels keys (omit, or one label per key; blank and comment lines in `-R` are skipped). Labels are metadata; identify recipients by public key.

When the profile has files, `recipient add` and `recipient remove` decrypt every saved file, re-encrypt for the updated public keys, and commit the list and ciphertext together. A private identity is required unless the profile is empty. Prefer a master public key in every profile; keep its private key out of developer clones' `.git/vaultkey.age`. The last public key cannot be removed. Profiles can be removed only when empty; `default` cannot. These updates support `-b`, `-n`, and `-B` (`init` creates its own branch).

`recipient remove` re-encrypts the current tip. Older commits and private keys elsewhere stay as they are. For offboarding: remove the public key, have them delete the local clone (and other copies of the identity), and rotate secret values when past access must end. Prefer one identity per clone.

## Git integration and limits

Use ordinary `git fetch`, `git push`, and the project's PR process when the task includes synchronization. `git fetch origin` normally updates `origin/vault`, not local `vault`. When creating a working branch, select the intended base explicitly.

If vault history diverges, keep the needed local changes and reapply them from the latest base. If recipients in the same profile changed since the working branch was created, re-save against the updated list before merging.

Saving keeps plaintext; restoring creates it; removal changes only the current vault snapshot. File names, recipients, labels, profile names, sizes, and commit metadata are public. Excluding plaintext from the application branch (for example with `.gitignore`) is the user's responsibility.

On failure, inspect stderr without exposing keys or plaintext. Retry from a refreshed base only after understanding the failure.

"""


def output_skill(args):
    if args.output is None:
        if args.force:
            raise VaultError("--force requires --output.", 2)
        sys.stdout.write(SKILL_CONTENT)
        return
    path = Path(args.output).expanduser()
    if path.is_symlink():
        raise VaultError(f"Refusing to overwrite a symlink: {path}")
    if path.exists() and not args.force:
        raise VaultError(f"File already exists: {path}. Use -f to overwrite it.")
    if path.exists() and not path.is_file():
        raise VaultError(f"Not a regular file: {path}")
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".git-vault-skill-", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as stream:
            stream.write(SKILL_CONTENT)
        if args.force:
            os.replace(temporary, path)
        else:
            os.link(temporary, path)
        print(f"Wrote skill: {path}", file=sys.stderr)
    finally:
        Path(temporary).unlink(missing_ok=True)


class VaultError(Exception):
    def __init__(self, message, code=1):
        super().__init__(message)
        self.code = code


def run(command, data=None, cwd=None, check=True, private=False):
    result = subprocess.run(command, input=data, stdout=subprocess.PIPE, stderr=subprocess.PIPE, cwd=cwd, check=False)
    if check and result.returncode:
        # age diagnostics can include malformed identity contents. Never echo them.
        detail = "" if private else result.stderr.decode("utf-8", "replace").strip()
        raise VaultError(detail or f"{command[0]} failed (exit {result.returncode}).")
    return result


def valid_profile(name):
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*", name) or name == VAULT_README_NAME:
        raise VaultError(f"Invalid profile name: {name}", 2)
    return name


def valid_path(name):
    try:
        name.encode("utf-8")
    except UnicodeError:
        raise VaultError("Paths must be valid UTF-8.") from None
    parts = name.split("/")
    if (
        not name
        or any(p in ("", ".", "..") or p.lower() == ".git" for p in parts)
        or "\\" in name
        or any(ord(c) < 32 or ord(c) == 127 for c in name)
    ):
        raise VaultError(f"Unsupported file path: {name!r}")
    return name


CONFIG_SCOPE_ORDER = ("command", "worktree", "local", "global", "system")


class StoreOnce(argparse.Action):
    def __call__(self, parser, namespace, values, option_string=None):
        if getattr(namespace, self.dest) is not None:
            parser.error(f"{option_string} may be specified at most once")
        setattr(namespace, self.dest, values)


def valid_label(label):
    if not isinstance(label, str):
        raise VaultError("Recipient labels must be strings.", 2)
    label = label.strip()
    if not label or "\0" in label or "\n" in label or "\r" in label:
        raise VaultError("Recipient labels must be nonempty and contain no NUL or newlines.", 2)
    return label


def normalize_key(key):
    if not isinstance(key, str):
        raise VaultError("Public keys must be strings.", 2)
    key = key.strip()
    if not key or "\0" in key or "\n" in key or "\r" in key or not key.startswith("age"):
        raise VaultError("Invalid public key.", 2)
    return key


def ensure_age_identity(path):
    with open(path, "rb") as handle:
        data = handle.read()
    if b"AGE-SECRET-KEY-" not in data:
        raise VaultError("Invalid identity file.")


def pair_recipients(keys, labels):
    labels = list(labels or [])
    if labels and len(labels) != len(keys):
        raise VaultError("Provide zero labels or one label per public key.", 2)
    if not labels:
        return [(key, None) for key in keys]
    return list(zip(keys, [valid_label(label) for label in labels], strict=True))


def normalize_recipients(pairs):
    seen = set()
    recipients = []
    for key, label in pairs:
        key = normalize_key(key)
        if label is not None:
            label = valid_label(label)
        if key in seen:
            raise VaultError(f"Duplicate public key: {key}", 2)
        seen.add(key)
        recipients.append((key, label))
    if not recipients:
        raise VaultError("At least one public key is required.")
    return sorted(recipients, key=lambda item: item[0])


def recipient_keys(recipients):
    return [key for key, _ in recipients]


def format_recipient_line(key, label):
    return f"{key}  {label}" if label else key


def dump_recipients_json(recipients):
    items = []
    for key, label in recipients:
        entry = {"key": key}
        if label is not None:
            entry["label"] = label
        items.append(entry)
    return json.dumps({"recipients": items, "version": 1}, ensure_ascii=False, indent=2, sort_keys=True) + "\n"


def parse_recipients_json(text):
    if not text.endswith("\n"):
        raise VaultError("Invalid recipients file.")
    try:
        doc = json.loads(text)
    except json.JSONDecodeError as error:
        raise VaultError("Invalid recipients file.") from error
    if not isinstance(doc, dict) or set(doc) != {"version", "recipients"}:
        raise VaultError("Invalid recipients file.")
    if doc.get("version") != 1:
        raise VaultError("Invalid recipients file.")
    raw = doc.get("recipients")
    if not isinstance(raw, list) or not raw:
        raise VaultError("Invalid recipients file.")
    pairs = []
    for item in raw:
        if not isinstance(item, dict) or "key" not in item:
            raise VaultError("Invalid recipients file.")
        extra = set(item) - {"key", "label"}
        if extra:
            raise VaultError("Invalid recipients file.")
        if "label" in item:
            if item["label"] is None or not isinstance(item["label"], str):
                raise VaultError("Invalid recipients file.")
            pairs.append((item["key"], item["label"]))
        else:
            pairs.append((item["key"], None))
    recipients = normalize_recipients(pairs)
    if dump_recipients_json(recipients) != text:
        raise VaultError("Invalid recipients file.")
    return recipients


def encrypt(data, keys):
    command = ["age", "--encrypt"]
    for key in keys:
        command.extend(["-r", key])
    return run(command, data).stdout


def validate_recipients(pairs):
    recipients = normalize_recipients(pairs)
    keys = recipient_keys(recipients)
    for key in keys:
        encrypt(b"", [key])
    if len(keys) > 1:
        encrypt(b"", keys)
    return recipients


def read_recipients_file(path):
    if path == "-":
        text = sys.stdin.read()
    else:
        file = Path(path)
        if not file.is_file():
            raise VaultError(f"Recipients file not found: {path}", 2)
        text = file.read_text(encoding="utf-8")
    keys = []
    for line in text.splitlines():
        if not line or line.startswith("#"):
            continue
        keys.append(line)
    return keys


def check_recipient_stdin(args):
    if getattr(args, "recipients_file", None) == "-" and getattr(args, "identity", None) == "-":
        raise VaultError("Cannot use -R - and -i - together.", 2)


def recipients_from_cli(args, *, labels=True):
    recipient = getattr(args, "recipient", None)
    recipients_file = getattr(args, "recipients_file", None)
    if recipient is not None and recipients_file is not None:
        raise VaultError("Use either -r/--recipient or -R/--recipients-file, not both.", 2)
    if recipient is None and recipients_file is None:
        raise VaultError("Specify -r/--recipient or -R/--recipients-file.", 2)
    if recipient is not None:
        keys = [recipient]
    else:
        keys = read_recipients_file(recipients_file)
        if not keys:
            raise VaultError("No public keys found in -R/--recipients-file.", 2)
    label_args = getattr(args, "label", None) if labels else None
    return validate_recipients(pair_recipients(keys, label_args))


def expand_identity_file(value):
    try:
        return Path(value).expanduser()
    except RuntimeError:
        raise VaultError(f"Cannot expand home directory in identity path: {value}") from None


IDENTITY_PLACEHOLDER_RE = re.compile(r"\$\{([A-Za-z_][A-Za-z0-9_]*)\}|\$([A-Za-z_][A-Za-z0-9_]*)")


def expand_identity_placeholders(value, mapping):
    def replace(match):
        name = match.group(1) or match.group(2)
        if name not in mapping:
            raise VaultError(f"Unknown vault.identity placeholder: ${name}")
        return mapping[name]

    return IDENTITY_PLACEHOLDER_RE.sub(replace, value)


def expand_identity_path(value, repo):
    if not isinstance(value, str) or value == "-" or "\0" in value or "\n" in value or "\r" in value:
        raise VaultError("Invalid vault.identity path.")
    expanded = expand_identity_placeholders(
        value,
        {
            "GIT_COMMON_DIR": str(repo.common_dir),
            "TOPLEVEL": str(repo.root),
        },
    )
    if not (expanded.startswith("~") or os.path.isabs(expanded)):
        raise VaultError(
            "vault.identity must be an absolute path, start with ~, or use $GIT_COMMON_DIR / $TOPLEVEL."
        )
    return str(expand_identity_file(expanded))


def vault_identity_path(repo):
    result = repo.git("config", "--includes", "--show-scope", "--null", "--get-all", "vault.identity", check=False)
    if result.returncode not in (0, 1):
        raise VaultError("Cannot read vault.identity from git config.")
    raw = result.stdout
    if not raw:
        return None
    parts = raw.split(b"\0")
    if parts and parts[-1] == b"":
        parts = parts[:-1]
    if len(parts) % 2:
        raise VaultError("Cannot parse vault.identity from git config.")
    entries = []
    for index in range(0, len(parts), 2):
        scope = parts[index].decode("utf-8", "surrogateescape")
        value = parts[index + 1].decode("utf-8", "surrogateescape")
        entries.append((scope, value))
    chosen = next((scope for scope in CONFIG_SCOPE_ORDER if any(item[0] == scope for item in entries)), None)
    if chosen is None:
        return None
    values = [expand_identity_path(value, repo) for scope, value in entries if scope == chosen]
    if len(values) > 1:
        raise VaultError("vault.identity must be a single path; multiple values are not supported.")
    return values[0]


AGE_ENCRYPTED_PREFIX = b"age-encryption.org/"
AGE_ARMOR_PREFIX = b"-----BEGIN AGE ENCRYPTED FILE-----"


def identity_is_passphrase_encrypted(path):
    with open(path, "rb") as handle:
        head = handle.read(max(len(AGE_ENCRYPTED_PREFIX), len(AGE_ARMOR_PREFIX)))
    return head.startswith(AGE_ENCRYPTED_PREFIX) or head.startswith(AGE_ARMOR_PREFIX)


def ensure_identity_temp(temporary):
    if temporary is not None:
        return temporary
    temporary = tempfile.TemporaryDirectory(prefix="git-vault-key-")
    os.chmod(temporary.name, 0o700)
    return temporary


def unlock_passphrase_identity(encrypted_path, destination):
    # age reads the passphrase from /dev/tty when stdin is not a terminal.
    result = subprocess.run(
        ["age", "--decrypt", "-o", str(destination), str(encrypted_path)],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode == 0:
        os.chmod(destination, 0o600)
        return
    detail = result.stderr.decode("utf-8", "replace").strip()
    if "AGE-SECRET-KEY-" in detail:
        detail = ""
    raise VaultError(
        detail
        or "Failed to unlock identity file. Check the passphrase and that the file is a passphrase-protected age identity."
    )


@contextmanager
def identities(repo, path):
    temporary = None
    try:
        if path is not None:
            if path == "-":
                content = sys.stdin.buffer.read()
                if not content.strip():
                    raise VaultError("No private key supplied on stdin.")
                temporary = ensure_identity_temp(temporary)
                source = Path(temporary.name) / "identity"
                fd = os.open(source, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
                with os.fdopen(fd, "wb") as stream:
                    stream.write(content)
            else:
                source = expand_identity_file(path).absolute()
                if not source.is_file():
                    raise VaultError(f"Identity file not found: {path}")
        else:
            config_path = vault_identity_path(repo)
            if config_path is None:
                raise VaultError("No identity specified. Use -i or set vault.identity.")
            source = Path(config_path)
            if not source.is_file():
                raise VaultError(f"Identity file not found: {config_path}")

        if identity_is_passphrase_encrypted(source):
            temporary = ensure_identity_temp(temporary)
            unlocked = Path(temporary.name) / "identity.plain"
            unlock_passphrase_identity(source, unlocked)
            ensure_age_identity(unlocked)
            yield [str(unlocked)]
        else:
            ensure_age_identity(source)
            yield [str(source)]
    finally:
        if temporary is not None:
            temporary.cleanup()


def decrypt(data, paths):
    command = ["age", "--decrypt"]
    for path in paths:
        command.extend(["-i", path])
    try:
        return run(command, data, private=True).stdout
    except VaultError as error:
        raise VaultError(f"{error} Check the identity, ciphertext, and required age plugins.") from None


@dataclass
class Profile:
    recipients: list
    files: dict


class Repository:
    def __init__(self):
        self.cwd = Path.cwd().resolve()
        root = run(["git", "rev-parse", "--show-toplevel"], check=False)
        if root.returncode:
            raise VaultError("Run git-vault inside a Git working tree.")
        self.root = Path(os.fsdecode(root.stdout.rstrip(b"\n"))).resolve()
        self.git_dirs = []
        for flag in ("--absolute-git-dir", "--git-common-dir"):
            value = self.git("rev-parse", flag).stdout.rstrip(b"\n")
            self.git_dirs.append((self.root / os.fsdecode(value)).resolve())
        self.common_dir = self.git_dirs[1]

    def git(self, *args, data=None, check=True):
        return run(["git", *args], data=data, cwd=self.root, check=check)

    def blob(self, oid):
        return self.git("cat-file", "blob", oid).stdout

    def hash_blob(self, content):
        return self.git("hash-object", "-w", "--stdin", data=content).stdout.decode().strip()

    def branch_ref(self, name):
        if (
            name.startswith("-")
            or "@{" in name
            or self.git("check-ref-format", "--branch", name, check=False).returncode
        ):
            raise VaultError(f"Invalid branch name: {name}", 2)
        ref = "refs/heads/" + name
        if self.git("symbolic-ref", "-q", ref, check=False).returncode == 0:
            raise VaultError(f"Symbolic branch refs are not supported: {name}")
        return ref

    def branch_oid(self, ref):
        result = self.git("show-ref", "--verify", "--hash", ref, check=False)
        if result.returncode:
            return None
        return result.stdout.decode().strip()

    def commit_oid(self, revision):
        result = self.git("rev-parse", "--verify", "--end-of-options", revision + "^{commit}", check=False)
        if result.returncode:
            raise VaultError(f"Cannot resolve commit: {revision}")
        return result.stdout.decode().strip()

    def ensure_not_checked_out(self, ref):
        worktrees = self.git("worktree", "list", "--porcelain").stdout.splitlines()
        if ("branch " + ref).encode() in worktrees:
            raise VaultError(f"Target branch is checked out in a worktree: {ref}")

    def load(self, oid):
        profiles = {}
        directories = set()
        entries = self.git("ls-tree", "-r", "-t", "-z", oid).stdout.split(b"\0")
        for entry in filter(None, entries):
            meta, raw_name = entry.split(b"\t", 1)
            try:
                name = raw_name.decode("utf-8")
            except UnicodeError:
                raise VaultError("Vault tree contains a non-UTF-8 path.") from None
            valid_path(name)
            mode, kind, object_id = meta.decode("ascii").split()
            if mode == "040000" and kind == "tree":
                directories.add(name)
                continue
            if mode != "100644" or kind != "blob":
                raise VaultError(f"Unsupported vault tree entry: {name}")
            parts = name.split("/")
            if len(parts) < 2:
                if name == VAULT_README_NAME:
                    continue
                raise VaultError(f"Not a vault tree: unexpected entry {name}")
            profile_name = valid_profile(parts[0])
            profile = profiles.setdefault(profile_name, Profile([], {}))
            if len(parts) == 2 and parts[1] == "recipients.json":
                try:
                    text = self.blob(object_id).decode("utf-8")
                except UnicodeError:
                    raise VaultError("Recipients must be UTF-8.") from None
                try:
                    profile.recipients = parse_recipients_json(text)
                except VaultError as error:
                    raise VaultError(f"Invalid recipients file in profile {profile_name}") from error
            elif len(parts) >= 3 and parts[1] == "files":
                profile.files[valid_path("/".join(parts[2:]))] = object_id
            else:
                raise VaultError(f"Unexpected vault entry: {name}")
        if "default" not in profiles or any(not s.recipients for s in profiles.values()):
            raise VaultError("Not a vault tree: default profile and recipients are required.")
        allowed = set()
        for name, profile in profiles.items():
            base = name
            allowed.update((base, base + "/files"))
            for path in profile.files:
                pieces = path.split("/")
                for length in range(1, len(pieces)):
                    allowed.add(base + "/files/" + "/".join(pieces[:length]))
        if directories - allowed:
            raise VaultError("Vault tree contains unexpected directories.")
        return profiles

    def tree(self, profiles):
        flat = {VAULT_README_NAME: self.hash_blob(VAULT_README.encode())}
        for name, profile in profiles.items():
            base = f"{name}/"
            flat[base + "recipients.json"] = self.hash_blob(dump_recipients_json(profile.recipients).encode())
            for path, oid in profile.files.items():
                flat[base + "files/" + path] = oid
        nested = {}
        for path, oid in flat.items():
            node = nested
            parts = path.split("/")
            for part in parts[:-1]:
                child = node.setdefault(part, {})
                if not isinstance(child, dict):
                    raise VaultError(f"File/directory conflict in vault: {path}")
                node = child
            if isinstance(node.get(parts[-1]), dict):
                raise VaultError(f"File/directory conflict in vault: {path}")
            node[parts[-1]] = oid

        def write(node):
            entries = []
            for name, item in node.items():
                if isinstance(item, dict):
                    meta = f"040000 tree {write(item)}"
                else:
                    meta = f"100644 blob {item}"
                entries.append(meta.encode() + b"\t" + name.encode() + b"\0")
            return self.git("mktree", "-z", data=b"".join(entries)).stdout.decode().strip()
        return write(nested)

    def commit(self, ref, old_oid, parent, profiles, message):
        self.ensure_not_checked_out(ref)
        tree = self.tree(profiles)
        if parent:
            old_tree = self.git("rev-parse", parent + "^{tree}").stdout.decode().strip()
            if tree == old_tree:
                print("No changes.")
                return
        command = ["commit-tree", tree]
        if parent:
            command += ["-p", parent]
        oid = self.git(*command, data=message.encode("utf-8")).stdout.decode().strip()
        self.ensure_not_checked_out(ref)
        expected = old_oid or "0" * len(oid)
        result = self.git("update-ref", "--no-deref", "-m", "git-vault", ref, oid, expected, check=False)
        if result.returncode:
            raise VaultError("Cannot update branch: it changed concurrently or its ref name conflicts.", 3)
        print(f"{ref.removeprefix('refs/heads/')} {oid[:12]}")

    def relative_path(self, value):
        path = Path(value)
        if ".." in path.parts:
            raise VaultError(f"Parent traversal is not supported: {value}")
        absolute = path if path.is_absolute() else self.cwd / path
        try:
            name = absolute.relative_to(self.root).as_posix()
        except ValueError:
            raise VaultError(f"Path is outside the repository: {value}") from None
        return valid_path(name)

    def local_path(self, name):
        valid_path(name)
        path = self.root / name
        current = self.root
        for part in Path(name).parts:
            current = current / part
            if current.is_symlink():
                raise VaultError(f"Symlinks are not supported: {name}")
            if current.exists() and current != path and not current.is_dir():
                raise VaultError(f"Parent is not a directory: {name}")
        for directory in self.git_dirs:
            if path == directory or directory in path.parents:
                raise VaultError(f"Git administration paths are not supported: {name}")
        if path.exists() and not path.is_file():
            raise VaultError(f"Not a regular file: {name}")
        return path

    def tracked(self):
        return set(filter(None, self.git("ls-files", "-z").stdout.split(b"\0")))


def message_for(args, paths=()):
    if args.message is not None:
        message = "\n\n".join(args.message)
    elif args.message_file is not None:
        if args.message_file == "-" or not Path(args.message_file).is_file():
            raise VaultError("--message-file requires a regular UTF-8 file, not stdin.", 2)
        message = Path(args.message_file).read_text(encoding="utf-8")
    else:
        operation = args.operation
        if operation == "init":
            title = "Initialize vault"
        elif operation.startswith("profile-"):
            title = f"{operation.split('-')[1].capitalize()} profile {args.name}"
        elif operation.startswith("recipient-"):
            title = f"{operation.split('-')[1].capitalize()} recipients in profile {args.profile}"
        else:
            title = f"{operation.capitalize()} files in profile {args.profile}"
        message = "git-vault: " + title
        if paths:
            message += "\n\n" + "\n".join(paths)
    if not message.strip() or "\0" in message:
        raise VaultError("Commit messages must be nonempty and contain no NUL bytes.", 2)
    return message


def targets(repo, args, profile):
    if args.all:
        return sorted(profile.files)
    names = [repo.relative_path(path) for path in args.paths]
    return sorted(set(names))


def restore(repo, args, profile, names):
    tracked = repo.tracked()
    destinations = []
    for name in names:
        if name not in profile.files:
            raise VaultError(f"File is not saved in this profile: {name}")
        path = repo.local_path(name)
        if not args.force and (path.exists() or name.encode() in tracked):
            raise VaultError(f"Refusing to overwrite existing or tracked file: {name}. Use -f.")
        destinations.append(path)
    if not names:
        print("No files.")
        return
    with identities(repo, getattr(args, "identity", None)) as keys:
        contents = [decrypt(repo.blob(profile.files[name]), keys) for name in names]
    # Reject duplicate normalized destinations before writing any plaintext.
    aliases = [os.path.normcase(str(path.resolve())) for path in destinations]
    if len(set(aliases)) != len(aliases):
        raise VaultError("Multiple saved files resolve to the same destination.")
    pending = []
    placed = []
    try:
        for path, data in zip(destinations, contents):
            missing = []
            parent = path.parent
            while not parent.exists():
                missing.append(parent)
                parent = parent.parent
            for directory in reversed(missing):
                directory.mkdir(mode=0o700)
            fd, temporary = tempfile.mkstemp(prefix=".git-vault-", dir=path.parent)
            pending.append(Path(temporary))
            with os.fdopen(fd, "wb") as stream:
                stream.write(data)
        for name, path, temporary in zip(names, destinations, pending):
            repo.local_path(name)
            if args.force:
                os.replace(temporary, path)
            else:
                # link is an atomic no-clobber installation, unlike replace.
                os.link(temporary, path)
                temporary.unlink()
            placed.append(name)
            print(f"Restored: {name}")
    except OSError:
        if placed:
            print("Files already restored: " + ", ".join(placed), file=sys.stderr)
        raise
    finally:
        for temporary in pending:
            temporary.unlink(missing_ok=True)


@dataclass
class CompareResult:
    name: str
    status: str
    diff_text: str | None = None


def unified_diff_text(name, vault_data, work_data):
    try:
        vault_text = vault_data.decode("utf-8")
        work_text = work_data.decode("utf-8")
    except UnicodeDecodeError:
        return f"Binary files a/{name} and b/{name} differ\n"
    return "".join(difflib.unified_diff(
        vault_text.splitlines(keepends=True),
        work_text.splitlines(keepends=True),
        fromfile=f"a/{name}",
        tofile=f"b/{name}",
    ))


def compare_working_tree(repo, profile, names, identity_paths):
    results = []
    for name in names:
        if name not in profile.files:
            raise VaultError(f"File is not saved in this profile: {name}")
        path = repo.local_path(name)
        if not path.exists():
            results.append(CompareResult(name, "absent"))
            continue
        if not path.is_file():
            raise VaultError(f"Not a regular file: {name}")
        work_data = path.read_bytes()
        vault_data = decrypt(repo.blob(profile.files[name]), identity_paths)
        if work_data == vault_data:
            results.append(CompareResult(name, "same"))
        else:
            results.append(CompareResult(name, "changed", unified_diff_text(name, vault_data, work_data)))
    return results


def print_compare_diffs(results):
    for result in results:
        if result.status != "changed" or not result.diff_text:
            continue
        sys.stdout.write(result.diff_text)
        if not result.diff_text.endswith("\n"):
            sys.stdout.write("\n")


def diff_files(repo, args, profile, names):
    if not names:
        print("No files.")
        return 0
    with identities(repo, getattr(args, "identity", None)) as keys:
        results = compare_working_tree(repo, profile, names, keys)
    changed = False
    for result in results:
        if result.status == "absent":
            print(f"Absent: {result.name}")
        elif result.status == "changed":
            changed = True
    print_compare_diffs(results)
    return 1 if changed else 0


def clean(repo, args, profile, names):
    if not names:
        print("No files.")
        return
    for name in names:
        if name not in profile.files:
            raise VaultError(f"File is not saved in this profile: {name}")
    if not args.force:
        with identities(repo, getattr(args, "identity", None)) as keys:
            results = compare_working_tree(repo, profile, names, keys)
        changed = [result for result in results if result.status == "changed"]
        if changed:
            print_compare_diffs(changed)
            raise VaultError("Working tree differs from the vault. Use -f to delete anyway.")
    for name in names:
        path = repo.local_path(name)
        if not path.exists():
            print(f"Absent: {name}")
            continue
        if not path.is_file():
            raise VaultError(f"Not a regular file: {name}")
        path.unlink()
        print(f"Cleaned: {name}")


def execute(args):
    for command in ("git", "age"):
        if shutil.which(command) is None:
            raise VaultError(f"Required command not found: {command}")
    repo = Repository()
    branch = args.branch or "vault"
    ref = repo.branch_ref(branch)
    old_oid = repo.branch_oid(ref)
    update = args.operation not in (
        "list", "restore", "clean", "diff", "profile-list", "recipient-list",
    )
    if update:
        repo.ensure_not_checked_out(ref)
    if args.operation == "init":
        if old_oid:
            raise VaultError(f"Branch already exists: {branch}")
        check_recipient_stdin(args)
        message = message_for(args)
        profiles = {"default": Profile(recipients_from_cli(args), {})}
        repo.commit(ref, None, None, profiles, message)
        return
    new = getattr(args, "new_branch", False)
    if new:
        if old_oid:
            raise VaultError(f"Branch already exists: {branch}")
        parent = repo.commit_oid(args.base or "vault")
    else:
        if not old_oid:
            if args.operation in (
                "list", "restore", "clean", "diff", "profile-list", "recipient-list",
            ):
                raise VaultError(f"Branch does not exist: {branch}.")
            raise VaultError(f"Branch does not exist: {branch}. Use init or --new-branch.")
        parent = repo.commit_oid(ref)
    source = parent
    if args.operation == "restore" and args.revision:
        source = repo.commit_oid(args.revision)
        if repo.git("merge-base", "--is-ancestor", source, parent, check=False).returncode:
            raise VaultError("Revision is not reachable from the selected branch.")
    profiles = repo.load(source)
    if args.operation.startswith("profile-"):
        action = args.operation.split("-")[1]
        if action == "list":
            print("\n".join(sorted(profiles)))
            return
        name = valid_profile(args.name)
        if action == "add":
            if name in profiles:
                raise VaultError(f"Profile already exists: {name}")
            check_recipient_stdin(args)
            profiles[name] = Profile(recipients_from_cli(args), {})
        else:
            if name not in profiles:
                raise VaultError(f"Profile does not exist: {name}")
            if name == "default" or profiles[name].files:
                raise VaultError("Only empty, non-default profiles can be removed.")
            del profiles[name]
        repo.commit(ref, old_oid, parent, profiles, message_for(args))
        return
    valid_profile(args.profile)
    if args.profile not in profiles:
        raise VaultError(f"Profile does not exist: {args.profile}")
    profile = profiles[args.profile]
    if args.operation == "recipient-list":
        if getattr(args, "json", False):
            sys.stdout.write(dump_recipients_json(profile.recipients))
        else:
            print("\n".join(format_recipient_line(key, label) for key, label in profile.recipients))
        return
    if args.operation.startswith("recipient-"):
        check_recipient_stdin(args)
        existing = dict(profile.recipients)
        if args.operation == "recipient-add":
            supplied = dict(recipients_from_cli(args))
            if existing.keys() & supplied.keys():
                raise VaultError("A public key is already present.")
            recipients = validate_recipients([*existing.items(), *supplied.items()])
        else:
            supplied = dict(recipients_from_cli(args, labels=False))
            if not supplied.keys() <= existing.keys():
                raise VaultError("A public key is not present.")
            recipients = validate_recipients([(key, label) for key, label in existing.items() if key not in supplied])
        message = message_for(args)
        keys = recipient_keys(recipients)
        if profile.files:
            with identities(repo, getattr(args, "identity", None)) as identity_paths:
                files = {}
                for name, oid in profile.files.items():
                    plaintext = decrypt(repo.blob(oid), identity_paths)
                    files[name] = repo.hash_blob(encrypt(plaintext, keys))
            profile.files = files
        profile.recipients = recipients
        repo.commit(ref, old_oid, parent, profiles, message)
        return
    if args.operation == "list":
        if profile.files:
            print("\n".join(sorted(profile.files)))
        return
    names = targets(repo, args, profile)
    if args.operation == "restore":
        restore(repo, args, profile, names)
        return
    if args.operation == "diff":
        return diff_files(repo, args, profile, names)
    if args.operation == "clean":
        clean(repo, args, profile, names)
        return
    message = message_for(args, names)
    if args.operation == "remove":
        for name in names:
            if name not in profile.files:
                raise VaultError(f"File is not saved in this profile: {name}")
        for name in names:
            del profile.files[name]
    else:
        tracked = repo.tracked()
        paths = []
        for name in names:
            path = repo.local_path(name)
            if not path.is_file():
                raise VaultError(f"File not found: {name}")
            if name.encode() in tracked and not args.force:
                raise VaultError(f"Refusing to save tracked file: {name}. Use -f.")
            paths.append(path)
        keys = recipient_keys(profile.recipients)
        for name, path in zip(names, paths):
            profile.files[name] = repo.hash_blob(encrypt(path.read_bytes(), keys))
    if not names:
        print("No files.")
        return
    repo.commit(ref, old_oid, parent, profiles, message)


def parser_for_cli():
    requirements = (
        "Requires Python 3.11+, git, and age.\n"
        "Plaintext exclusion is your responsibility."
    )
    root_epilog = requirements + """

Examples:
  git vault init -r age...
  git vault save -p production -m 'Rotate credentials' -- .env
  git vault restore -a -i /path/to/identity
  git vault diff -p production -a
  git vault clean -p production -a
  git vault save -b vault-update -n -B origin/vault -- .env
"""
    parser = argparse.ArgumentParser(
        prog="git vault", description=__doc__, epilog=root_epilog,
        formatter_class=argparse.RawDescriptionHelpFormatter, allow_abbrev=False,
    )
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("version", help="Show the version.", description="Print the version and exit.", allow_abbrev=False)
    skill = commands.add_parser(
        "skill", help="Print or install the git-vault agent skill.",
        description="Print SKILL.md to stdout, or write it to a file.",
        epilog=(
            "Examples:\n  git vault skill\n  git vault skill -o\n"
            "  git vault skill -o .claude/skills/git-vault/SKILL.md\n"
            "Relative output paths are resolved from the current directory; parent directories are created."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter, allow_abbrev=False,
    )
    skill.add_argument(
        "-o", "--output", nargs="?", const=DEFAULT_SKILL_PATH, metavar="PATH",
        help=f"Write SKILL.md to a file (default when PATH is omitted: {DEFAULT_SKILL_PATH}).",
    )
    skill.add_argument("-f", "--force", action="store_true", help="Overwrite an existing output file; requires -o.")

    def leaf(
        group, name, operation, description, profile=False, update=False,
        create=False, identity=False, recipient=False, label=False, *,
        branch_help="Local branch to use (default: vault).",
        identity_help="Identity file. Use -i - for stdin, or omit and use vault.identity.",
        recipient_r_help="Public key (not with -R).",
        recipient_R_help="Recipients file; - for stdin (not with -r).",
    ):
        p = group.add_parser(
            name, description=description, help=description, epilog=requirements,
            formatter_class=argparse.RawDescriptionHelpFormatter, allow_abbrev=False,
        )
        p.set_defaults(operation=operation)
        p.add_argument("-b", "--branch", metavar="NAME", help=branch_help)
        if profile:
            p.add_argument("-p", "--profile", default="default", metavar="NAME", help="Profile to use (default: default).")
        if update:
            messages = p.add_mutually_exclusive_group()
            messages.add_argument(
                "-m", "--message", action="append", metavar="TEXT",
                help="Commit message; repeat for paragraphs. Do not include secrets.",
            )
            messages.add_argument(
                "-F", "--message-file", metavar="PATH",
                help="Read a UTF-8 commit message from a file.",
            )
        if create:
            p.add_argument(
                "-n", "--new-branch", action="store_true",
                help="Create the named -b branch; fail if it already exists.",
            )
            p.add_argument("-B", "--base", metavar="REF", help="Creation base (default: vault); requires -n.")
        if identity:
            p.add_argument(
                "-i", "--identity", action=StoreOnce, metavar="PATH", default=None,
                help=identity_help,
            )
        if recipient:
            recipient_input = p.add_mutually_exclusive_group(required=True)
            recipient_input.add_argument(
                "-r", "--recipient", action=StoreOnce, metavar="KEY", default=None,
                help=recipient_r_help,
            )
            recipient_input.add_argument(
                "-R", "--recipients-file", action=StoreOnce, metavar="PATH", default=None,
                help=recipient_R_help,
            )
        if label:
            p.add_argument(
                "-l", "--label", action="append", metavar="TEXT",
                help="Optional label; omit, or one per key in input order (blank and comment lines in -R are skipped).",
            )
        return p

    leaf(
        commands, "init", "init", "Initialize an independent vault branch.",
        update=True, recipient=True, label=True,
        branch_help="Local branch to create (default: vault).",
    )
    for name in ("profile", "recipient"):
        group_parser = commands.add_parser(name, help=f"Manage {name}s.")
        group = group_parser.add_subparsers(dest="action", required=True)
        listed = leaf(group, "list", name + "-list", f"List {name}s.", profile=name == "recipient")
        if name == "recipient":
            listed.add_argument("--json", action="store_true", help="Print recipients as canonical JSON.")
        profile_actions = {
            "add": "Create a profile with recipients and no files.",
            "remove": "Remove an empty non-default profile.",
        }
        recipient_actions = {
            "add": "Add recipients; re-encrypt saved files when needed.",
            "remove": "Remove recipients; re-encrypt saved files when needed.",
        }
        for action in ("add", "remove"):
            description = (profile_actions if name == "profile" else recipient_actions)[action]
            recipient_kwargs = {}
            if name == "recipient":
                recipient_kwargs = {
                    "identity_help": (
                        "Identity for re-encryption. Use -i - for stdin, or vault.identity. "
                        "Optional when the profile has no files."
                    ),
                    "recipient_r_help": (
                        "Public key to add (not with -R)."
                        if action == "add" else
                        "Public key to remove (not with -R)."
                    ),
                    "recipient_R_help": (
                        "Recipients file; - for stdin (not with -r)."
                        if action == "add" else
                        "Recipients file of keys to remove; - for stdin (not with -r)."
                    ),
                }
            p = leaf(
                group, action, name + "-" + action, description,
                profile=name == "recipient", update=True, create=True,
                identity=name == "recipient",
                recipient=(name == "profile" and action == "add") or (name == "recipient"),
                label=(name == "profile" and action == "add") or (name == "recipient" and action == "add"),
                **recipient_kwargs,
            )
            if name == "profile":
                p.add_argument("name", metavar="NAME", help="Profile name.")
    leaf(commands, "list", "list", "List saved paths in a profile.", profile=True)
    for operation in ("save", "restore", "remove"):
        p = leaf(
            commands, operation, operation,
            {
                "save": "Encrypt files and commit them to the vault branch.",
                "restore": "Decrypt files into the working tree.",
                "remove": "Remove saved files from the current snapshot.",
            }[operation],
            profile=True, update=operation != "restore", create=operation != "restore", identity=operation == "restore",
        )
        if operation in ("save", "restore"):
            p.add_argument(
                "-a", "--all", action="store_true",
                help="Use all saved paths in this profile; cannot be combined with explicit paths.",
            )
            p.add_argument(
                "-f", "--force", action="store_true",
                help=(
                    "Allow tracked input files. Reads working-tree content (not the index)."
                    if operation == "save" else
                    "Overwrite existing or tracked files, including uncommitted changes."
                ),
            )
        else:
            p.set_defaults(all=False)
        if operation == "restore":
            p.add_argument("--revision", metavar="REV", help="Restore from a reachable historical commit (default: branch tip).")
        p.add_argument(
            "paths",
            nargs="+" if operation == "remove" else "*",
            metavar="PATH",
            help="Paths relative to the current directory; use -- before leading hyphens.",
        )
    diff_parser = leaf(
        commands, "diff", "diff",
        "Compare working-tree plaintext to the latest saved snapshot; print unified diffs. "
        "Exit 1 when any selected path differs. Absent paths are reported.",
        profile=True, identity=True,
    )
    diff_parser.add_argument(
        "-a", "--all", action="store_true",
        help="Diff all saved paths in this profile; cannot be combined with explicit paths.",
    )
    diff_parser.add_argument(
        "paths", nargs="*", metavar="PATH",
        help="Paths relative to the current directory; use -- before leading hyphens.",
    )
    clean_parser = leaf(
        commands, "clean", "clean",
        "Delete working-tree plaintext for saved paths. "
        "Without -f, compare to the latest snapshot and abort if any path differs. "
        "With -f, delete unconditionally.",
        profile=True, identity=True,
    )
    clean_parser.add_argument(
        "-a", "--all", action="store_true",
        help="Clean all saved paths in this profile; cannot be combined with explicit paths.",
    )
    clean_parser.add_argument(
        "-f", "--force", action="store_true",
        help="Delete unconditionally.",
    )
    clean_parser.add_argument(
        "paths", nargs="*", metavar="PATH",
        help="Paths relative to the current directory; use -- before leading hyphens.",
    )
    return parser


def main():
    if sys.version_info < (3, 11):
        print("git-vault: Python 3.11 or later is required.", file=sys.stderr)
        return 1
    def interrupt(signum, frame):
        raise KeyboardInterrupt

    signal.signal(signal.SIGTERM, interrupt)
    parser = parser_for_cli()
    if len(sys.argv) == 1:
        parser.print_help()
        return 0
    args = parser.parse_args()
    if args.command == "version":
        print(VERSION)
        return 0
    if getattr(args, "new_branch", False) and args.branch is None:
        parser.error("--new-branch requires an explicit --branch")
    if getattr(args, "base", None) is not None and not args.new_branch:
        parser.error("--base requires --new-branch")
    if hasattr(args, "paths") and hasattr(args, "all") and bool(args.paths) == bool(args.all):
        parser.error("specify file paths" if args.operation == "remove" else "specify file paths or --all, exclusively")
    try:
        if args.command == "skill":
            output_skill(args)
            return 0
        code = execute(args)
        return 0 if code is None else code
    except VaultError as error:
        print(f"git-vault: {error}", file=sys.stderr)
        return error.code
    except (OSError, UnicodeError) as error:
        print(f"git-vault: {error}", file=sys.stderr)
        return 1
    except (KeyboardInterrupt, EOFError):
        print("git-vault: Interrupted.", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
