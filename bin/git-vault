#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Store age-encrypted files in a separate Git branch, without Python packages."""

import argparse
from contextlib import contextmanager
from dataclasses import dataclass
import getpass
import os
from pathlib import Path
import re
import shutil
import signal
import subprocess
import sys
import tempfile

VERSION = "0.3.0"

DEFAULT_SKILL_PATH = ".agents/skills/git-vault/SKILL.md"

SKILL_CONTENT = """---
name: git-vault
description: Save and restore encrypted project files with git-vault, including sections, recipients, and working branches for pull requests. Use when a project uses git-vault or the user asks to manage files with git vault.
---

# git-vault

Use `git vault` to manage encrypted files on a separate Git branch without
switching the application checkout. Python 3.11+, Git, and age are required.
Use `git vault <command> -h` for details; options follow the operation name.

Official repository: https://github.com/kohkimakimoto/git-vault
Use its [README](https://github.com/kohkimakimoto/git-vault#readme) for documentation
and [source code](https://github.com/kohkimakimoto/git-vault/blob/main/bin/git-vault)
when command behavior or implementation details need clarification.

## Check availability

Before performing vault operations, check that the command can run:

```sh
git vault version
```

If git-vault is not installed or not found on PATH, consult the official
repository's [installation instructions](https://github.com/kohkimakimoto/git-vault#installation).
Research the current installation options and prerequisites for the user's
environment, then propose the appropriate commands. Install it only when that
is within the user's requested scope; otherwise provide the proposal and wait
before attempting vault operations. If the documentation cannot be reached,
explain what could not be verified instead of inventing installation steps.

If the command exists but fails, inspect the error and distinguish a missing
installation from Python, PATH, or other dependency problems. Use the repository
as the information source for troubleshooting, and confirm `git vault version`
works after installation or repair before continuing.

## Choose the target

The default local branch is `vault` and the default section is `default`.
Sections group files and recipients within the same branch. Before updating an
existing vault, inspect its sections, saved paths, and public recipients:

```sh
git vault sections list
git vault list -s production
git vault recipients list -s production
```

Use the section and branch requested by the user or established by the project;
do not infer production from a filename. Paths are relative to the current
directory. Prefer explicit paths when the task concerns only some files.

## Save files

```sh
git vault save -s production -m "Update application secrets" -- .env
```

This creates a local commit on the selected branch, keeps source plaintext, and
leaves the application branch and index unchanged. Unspecified files are kept.
Use `-b NAME` to update an existing vault working branch.

For a pull-request workflow, create a new branch explicitly:

```sh
git vault save -s production -b vault-update-secrets -n -B origin/vault -- .env
git vault save -s production -b vault-update-secrets -- credentials.json
```

`-n` requires an explicit `-b` and rejects an existing branch. `-B` requires `-n`
and defaults to local `vault`; `origin/vault` must already have been fetched.
Do not use `vault/update-secrets`: Git cannot have both `vault` and that name.
Updating a branch checked out in any worktree is rejected.

`save -a` re-saves every registered path in the selected section, not new files.
Use it only when the task calls for the entire section; a missing source fails
the operation. Commit messages are public. Omit `-m` for a generated message
prefixed with `git-vault:`; never put secret values in a message.

## Restore files

```sh
git vault restore -s production -i /path/to/identity -- .env
git vault restore -s production -- .env < /path/to/identity
```

Use an identity file or redirect its contents without reading or printing private
keys into the conversation or command arguments. Repeat `-i` for multiple identity
files. Without `-i`, non-terminal stdin supplies identity contents; terminal stdin
prompts without echo. Prefer file input for noninteractive agent execution.

Restore writes plaintext files with mode `0600`. Do not print restored secrets;
inspect names and command exit status when contents are unnecessary to the task.
`restore -a` restores the whole section. `-R REV` restores a historical commit
reachable from the selected branch.

Existing files and tracked paths are rejected by default. Use `restore -f` only
when overwriting the destination, including any uncommitted changes, is within
the user's requested scope. `save -f` permits tracked input and reads its working
tree content, not the staged version. Neither command modifies the index or
removes plaintext from application history. Do not add `-f` just to bypass an
unexpected failure; inspect the reported path and intended operation first.

## Initialize, organize, and rotate recipients

Only initialize when the task calls for a new vault. If `origin/vault` already
exists, use that history instead of creating an independent vault:

```sh
git branch --track vault origin/vault
```

For a new vault or section, obtain the intended public recipients from the user
or project context. Native age public keys start with `age1`.

```sh
git vault init -r age1...
git vault sections add production -r age1...
git vault recipients add -s production -i /path/to/identity age1...
git vault recipients remove -s production -i /path/to/identity age1...
git vault remove -s production -- .env
git vault sections remove production
```

Repeat `-r` to initialize with multiple recipients. Recipient changes re-encrypt
all files in the selected section and commit the list and ciphertext together;
an identity that can decrypt every file is needed unless the section is empty.
Failure leaves the branch unchanged. The last recipient cannot be removed.
Sections can be removed only when empty, and `default` cannot be removed.
These updates also support `-b`, `-n`, and `-B` (except `init`).

## Git integration and limits

Use ordinary `git fetch`, `git push`, and the project's PR process when the task
includes synchronization. Local save does not authorize publishing changes.
`git fetch origin` normally updates `origin/vault`, not local `vault`. When
creating a working branch, select the intended current base explicitly.

Do not auto-merge ciphertext or force-push a divergent vault. Retain the needed
local changes and reapply them from the latest base. If recipients in the same
section changed since the working branch was created, re-save against the updated
list before merging; a conflict-free Git merge alone does not ensure consistency.

Ignore settings are the user's responsibility; git-vault does not manage them.
Saving keeps plaintext, restoring creates plaintext, and removal only changes the
current vault snapshot. Clones and history retain old ciphertext, so deleting a
file or recipient does not revoke access to past versions. File names, recipients,
section names, sizes, and commit metadata are public within the repository.

On failure, inspect stderr without exposing keys or plaintext. Exit codes are
0 for success, 1 for operation failure, 2 for invalid arguments, and 3 for a
concurrent ref update or creation conflict. Retry from a refreshed base only
after understanding the failure; do not overwrite someone else's update.
"""


def output_skill(args):
    if args.output is None:
        if args.force:
            raise VaultError("--force requires --output.", 2)
        sys.stdout.write(SKILL_CONTENT)
        return
    path = Path(args.output).expanduser()
    if path.is_symlink():
        raise VaultError(f"Refusing to overwrite a symlink: {path}")
    if path.exists() and not args.force:
        raise VaultError(f"File already exists: {path}. Use -f to overwrite it.")
    if path.exists() and not path.is_file():
        raise VaultError(f"Not a regular file: {path}")
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".git-vault-skill-", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as stream:
            stream.write(SKILL_CONTENT)
        if args.force:
            os.replace(temporary, path)
        else:
            os.link(temporary, path)
        print(f"Wrote skill: {path}", file=sys.stderr)
    finally:
        Path(temporary).unlink(missing_ok=True)


class VaultError(Exception):
    def __init__(self, message, code=1):
        super().__init__(message)
        self.code = code


def run(command, data=None, cwd=None, check=True, private=False):
    result = subprocess.run(command, input=data, stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE, cwd=cwd, check=False)
    if check and result.returncode:
        # age diagnostics can include malformed identity contents. Never echo them.
        detail = "" if private else result.stderr.decode("utf-8", "replace").strip()
        raise VaultError(detail or f"{command[0]} failed (exit {result.returncode}).")
    return result


def valid_section(name):
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*", name):
        raise VaultError(f"Invalid section name: {name}", 2)
    return name


def valid_path(name):
    try:
        name.encode("utf-8")
    except UnicodeError:
        raise VaultError("Paths must be valid UTF-8.") from None
    parts = name.split("/")
    if (not name or any(p in ("", ".", "..") or p.lower() == ".git" for p in parts)
            or "\\" in name or any(ord(c) < 32 or ord(c) == 127 for c in name)):
        raise VaultError(f"Unsupported file path: {name!r}")
    return name


def recipient_list(keys):
    keys = sorted(set(keys))
    if not keys or any(not re.fullmatch(r"age1[023456789acdefghjklmnpqrstuvwxyz]{58}", k)
                       for k in keys):
        raise VaultError("At least one valid native age recipient (age1...) is required.")
    return keys


def encrypt(data, keys):
    command = ["age", "--encrypt"]
    for key in keys:
        command.extend(["-r", key])
    return run(command, data, private=True).stdout


def validate_recipients(keys):
    keys = recipient_list(keys)
    encrypt(b"", keys)  # Let age validate the Bech32 checksum as well.
    return keys


@contextmanager
def identities(paths):
    if paths:
        resolved = []
        for path in paths:
            file = Path(path).absolute()
            if not file.is_file():
                raise VaultError(f"Identity file not found: {path}")
            resolved.append(str(file))
        yield resolved
        return
    if sys.stdin.isatty():
        content = getpass.getpass("Input private key content: ").encode("utf-8")
    else:
        content = sys.stdin.buffer.read()
    if not content.strip():
        raise VaultError("No private key supplied. Use -i, stdin, or interactive input.")
    with tempfile.TemporaryDirectory(prefix="git-vault-key-") as directory:
        os.chmod(directory, 0o700)
        path = Path(directory) / "identity"
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "wb") as stream:
            stream.write(content)
        yield [str(path)]


def decrypt(data, paths):
    command = ["age", "--decrypt"]
    for path in paths:
        command.extend(["-i", path])
    return run(command, data, private=True).stdout


@dataclass
class Section:
    recipients: list
    files: dict


class Repository:
    def __init__(self):
        self.cwd = Path.cwd().resolve()
        root = run(["git", "rev-parse", "--show-toplevel"], check=False)
        if root.returncode:
            raise VaultError("Run git-vault inside a Git working tree.")
        self.root = Path(os.fsdecode(root.stdout.rstrip(b"\n"))).resolve()
        self.git_dirs = []
        for flag in ("--absolute-git-dir", "--git-common-dir"):
            value = self.git("rev-parse", flag).stdout.rstrip(b"\n")
            self.git_dirs.append((self.root / os.fsdecode(value)).resolve())

    def git(self, *args, data=None, check=True):
        return run(["git", *args], data=data, cwd=self.root, check=check)

    def blob(self, oid):
        return self.git("cat-file", "blob", oid).stdout

    def hash_blob(self, content):
        return self.git("hash-object", "-w", "--stdin", data=content).stdout.decode().strip()

    def branch_ref(self, name):
        if (name.startswith("-") or "@{" in name
                or self.git("check-ref-format", "--branch", name, check=False).returncode):
            raise VaultError(f"Invalid branch name: {name}", 2)
        ref = "refs/heads/" + name
        if self.git("symbolic-ref", "-q", ref, check=False).returncode == 0:
            raise VaultError(f"Symbolic branch refs are not supported: {name}")
        return ref

    def branch_oid(self, ref):
        result = self.git("show-ref", "--verify", "--hash", ref, check=False)
        if result.returncode:
            return None
        return result.stdout.decode().strip()

    def commit_oid(self, revision):
        result = self.git("rev-parse", "--verify", "--end-of-options",
                          revision + "^{commit}", check=False)
        if result.returncode:
            raise VaultError(f"Cannot resolve commit: {revision}")
        return result.stdout.decode().strip()

    def ensure_not_checked_out(self, ref):
        worktrees = self.git("worktree", "list", "--porcelain").stdout.splitlines()
        if ("branch " + ref).encode() in worktrees:
            raise VaultError(f"Target branch is checked out in a worktree: {ref}")

    def load(self, oid):
        sections = {}
        directories = set()
        entries = self.git("ls-tree", "-r", "-t", "-z", oid).stdout.split(b"\0")
        for entry in filter(None, entries):
            meta, raw_name = entry.split(b"\t", 1)
            try:
                name = raw_name.decode("utf-8")
            except UnicodeError:
                raise VaultError("Vault tree contains a non-UTF-8 path.") from None
            valid_path(name)
            mode, kind, object_id = meta.decode("ascii").split()
            if mode == "040000" and kind == "tree":
                directories.add(name)
                continue
            if mode != "100644" or kind != "blob":
                raise VaultError(f"Unsupported vault tree entry: {name}")
            parts = name.split("/")
            if len(parts) < 3 or parts[0] != "sections":
                raise VaultError(f"Not a vault tree: unexpected entry {name}")
            section_name = valid_section(parts[1])
            section = sections.setdefault(section_name, Section([], {}))
            if len(parts) == 3 and parts[2] == "recipients":
                try:
                    text = self.blob(object_id).decode("utf-8")
                except UnicodeError:
                    raise VaultError("Recipients must be UTF-8.") from None
                keys = text.splitlines()
                if not text.endswith("\n") or keys != sorted(set(keys)):
                    raise VaultError(f"Invalid recipients file in section {section_name}")
                section.recipients = recipient_list(keys)
            elif len(parts) >= 4 and parts[2] == "files":
                section.files[valid_path("/".join(parts[3:]))] = object_id
            else:
                raise VaultError(f"Unexpected vault entry: {name}")
        if "default" not in sections or any(not s.recipients for s in sections.values()):
            raise VaultError("Not a vault tree: default section and recipients are required.")
        allowed = {"sections"}
        for name, section in sections.items():
            base = f"sections/{name}"
            allowed.update((base, base + "/files"))
            for path in section.files:
                pieces = path.split("/")
                for length in range(1, len(pieces)):
                    allowed.add(base + "/files/" + "/".join(pieces[:length]))
        if directories - allowed:
            raise VaultError("Vault tree contains unexpected directories.")
        return sections

    def tree(self, sections):
        flat = {}
        for name, section in sections.items():
            base = f"sections/{name}/"
            flat[base + "recipients"] = self.hash_blob(
                ("\n".join(section.recipients) + "\n").encode())
            for path, oid in section.files.items():
                flat[base + "files/" + path] = oid
        nested = {}
        for path, oid in flat.items():
            node = nested
            parts = path.split("/")
            for part in parts[:-1]:
                child = node.setdefault(part, {})
                if not isinstance(child, dict):
                    raise VaultError(f"File/directory conflict in vault: {path}")
                node = child
            if isinstance(node.get(parts[-1]), dict):
                raise VaultError(f"File/directory conflict in vault: {path}")
            node[parts[-1]] = oid

        def write(node):
            entries = []
            for name, item in node.items():
                if isinstance(item, dict):
                    meta = f"040000 tree {write(item)}"
                else:
                    meta = f"100644 blob {item}"
                entries.append(meta.encode() + b"\t" + name.encode() + b"\0")
            return self.git("mktree", "-z", data=b"".join(entries)).stdout.decode().strip()
        return write(nested)

    def commit(self, ref, old_oid, parent, sections, message):
        self.ensure_not_checked_out(ref)
        tree = self.tree(sections)
        if parent:
            old_tree = self.git("rev-parse", parent + "^{tree}").stdout.decode().strip()
            if tree == old_tree:
                print("No changes.")
                return
        command = ["commit-tree", tree]
        if parent:
            command += ["-p", parent]
        oid = self.git(*command, data=message.encode("utf-8")).stdout.decode().strip()
        self.ensure_not_checked_out(ref)
        expected = old_oid or "0" * len(oid)
        result = self.git("update-ref", "--no-deref", "-m", "git-vault", ref,
                          oid, expected, check=False)
        if result.returncode:
            raise VaultError("Cannot update branch: it changed concurrently or its ref name conflicts.", 3)
        print(f"{ref.removeprefix('refs/heads/')} {oid[:12]}")

    def relative_path(self, value):
        path = Path(value)
        if ".." in path.parts:
            raise VaultError(f"Parent traversal is not supported: {value}")
        absolute = path if path.is_absolute() else self.cwd / path
        try:
            name = absolute.relative_to(self.root).as_posix()
        except ValueError:
            raise VaultError(f"Path is outside the repository: {value}") from None
        return valid_path(name)

    def local_path(self, name):
        valid_path(name)
        path = self.root / name
        current = self.root
        for part in Path(name).parts:
            current = current / part
            if current.is_symlink():
                raise VaultError(f"Symlinks are not supported: {name}")
            if current.exists() and current != path and not current.is_dir():
                raise VaultError(f"Parent is not a directory: {name}")
        for directory in self.git_dirs:
            if path == directory or directory in path.parents:
                raise VaultError(f"Git administration paths are not supported: {name}")
        if path.exists() and not path.is_file():
            raise VaultError(f"Not a regular file: {name}")
        return path

    def tracked(self):
        return set(filter(None, self.git("ls-files", "-z").stdout.split(b"\0")))


def message_for(args, paths=()):
    if args.message is not None:
        message = "\n\n".join(args.message)
    elif args.message_file is not None:
        if args.message_file == "-" or not Path(args.message_file).is_file():
            raise VaultError("--message-file requires a regular UTF-8 file, not stdin.", 2)
        message = Path(args.message_file).read_text(encoding="utf-8")
    else:
        operation = args.operation
        if operation == "init":
            title = "Initialize vault"
        elif operation.startswith("sections-"):
            title = f"{operation.split('-')[1].capitalize()} section {args.name}"
        elif operation.startswith("recipients-"):
            title = f"{operation.split('-')[1].capitalize()} recipients in section {args.section}"
        else:
            title = f"{operation.capitalize()} files in section {args.section}"
        message = "git-vault: " + title
        if paths:
            message += "\n\n" + "\n".join(paths)
    if not message.strip() or "\0" in message:
        raise VaultError("Commit messages must be nonempty and contain no NUL bytes.", 2)
    return message


def targets(repo, args, section):
    if args.all:
        return sorted(section.files)
    names = [repo.relative_path(path) for path in args.paths]
    return sorted(set(names))


def restore(repo, args, section, names):
    tracked = repo.tracked()
    destinations = []
    for name in names:
        if name not in section.files:
            raise VaultError(f"File is not saved in this section: {name}")
        path = repo.local_path(name)
        if not args.force and (path.exists() or name.encode() in tracked):
            raise VaultError(f"Refusing to overwrite existing or tracked file: {name}. Use -f.")
        destinations.append(path)
    if not names:
        print("No files.")
        return
    with identities(args.identity) as keys:
        contents = [decrypt(repo.blob(section.files[name]), keys) for name in names]
    # Reject duplicate normalized destinations before writing any plaintext.
    aliases = [os.path.normcase(str(path.resolve())) for path in destinations]
    if len(set(aliases)) != len(aliases):
        raise VaultError("Multiple saved files resolve to the same destination.")
    pending = []
    placed = []
    try:
        for path, data in zip(destinations, contents):
            missing = []
            parent = path.parent
            while not parent.exists():
                missing.append(parent)
                parent = parent.parent
            for directory in reversed(missing):
                directory.mkdir(mode=0o700)
            fd, temporary = tempfile.mkstemp(prefix=".git-vault-", dir=path.parent)
            pending.append(Path(temporary))
            with os.fdopen(fd, "wb") as stream:
                stream.write(data)
        for name, path, temporary in zip(names, destinations, pending):
            repo.local_path(name)
            if args.force:
                os.replace(temporary, path)
            else:
                # link is an atomic no-clobber installation, unlike replace.
                os.link(temporary, path)
                temporary.unlink()
            placed.append(name)
            print(f"Restored: {name}")
    except OSError:
        if placed:
            print("Files already restored: " + ", ".join(placed), file=sys.stderr)
        raise
    finally:
        for temporary in pending:
            temporary.unlink(missing_ok=True)


def execute(args):
    for command in ("git", "age"):
        if shutil.which(command) is None:
            raise VaultError(f"Required command not found: {command}")
    repo = Repository()
    branch = args.branch or "vault"
    ref = repo.branch_ref(branch)
    old_oid = repo.branch_oid(ref)
    update = args.operation not in ("list", "restore", "sections-list", "recipients-list")
    if update:
        repo.ensure_not_checked_out(ref)
    if args.operation == "init":
        if old_oid:
            raise VaultError(f"Branch already exists: {branch}")
        message = message_for(args)
        sections = {"default": Section(validate_recipients(args.recipient), {})}
        repo.commit(ref, None, None, sections, message)
        return
    new = getattr(args, "new_branch", False)
    if new:
        if old_oid:
            raise VaultError(f"Branch already exists: {branch}")
        parent = repo.commit_oid(args.base or "vault")
    else:
        if not old_oid:
            raise VaultError(f"Branch does not exist: {branch}. Use init or --new-branch.")
        parent = repo.commit_oid(ref)
    source = parent
    if args.operation == "restore" and args.revision:
        source = repo.commit_oid(args.revision)
        if repo.git("merge-base", "--is-ancestor", source, parent, check=False).returncode:
            raise VaultError("Revision is not reachable from the selected branch.")
    sections = repo.load(source)
    if args.operation.startswith("sections-"):
        action = args.operation.split("-")[1]
        if action == "list":
            print("\n".join(sorted(sections)))
            return
        name = valid_section(args.name)
        if action == "add":
            if name in sections:
                raise VaultError(f"Section already exists: {name}")
            sections[name] = Section(validate_recipients(args.recipient), {})
        else:
            if name not in sections:
                raise VaultError(f"Section does not exist: {name}")
            if name == "default" or sections[name].files:
                raise VaultError("Only empty, non-default sections can be removed.")
            del sections[name]
        repo.commit(ref, old_oid, parent, sections, message_for(args))
        return
    valid_section(args.section)
    if args.section not in sections:
        raise VaultError(f"Section does not exist: {args.section}")
    section = sections[args.section]
    if args.operation == "recipients-list":
        print("\n".join(section.recipients))
        return
    if args.operation.startswith("recipients-"):
        supplied = recipient_list(args.keys)
        existing = set(section.recipients)
        if args.operation == "recipients-add":
            if existing.intersection(supplied):
                raise VaultError("A recipient is already present.")
            keys = validate_recipients(existing.union(supplied))
        else:
            if not set(supplied).issubset(existing):
                raise VaultError("A recipient is not present.")
            keys = validate_recipients(existing.difference(supplied))
        message = message_for(args)
        if section.files:
            with identities(args.identity) as identity_paths:
                files = {name: repo.hash_blob(encrypt(decrypt(repo.blob(oid), identity_paths), keys))
                         for name, oid in section.files.items()}
            section.files = files
        section.recipients = keys
        repo.commit(ref, old_oid, parent, sections, message)
        return
    if args.operation == "list":
        if section.files:
            print("\n".join(sorted(section.files)))
        return
    names = targets(repo, args, section)
    if args.operation == "restore":
        restore(repo, args, section, names)
        return
    message = message_for(args, names)
    if args.operation == "remove":
        for name in names:
            if name not in section.files:
                raise VaultError(f"File is not saved in this section: {name}")
        for name in names:
            del section.files[name]
    else:
        tracked = repo.tracked()
        paths = []
        for name in names:
            path = repo.local_path(name)
            if not path.is_file():
                raise VaultError(f"File not found: {name}")
            if name.encode() in tracked and not args.force:
                raise VaultError(f"Refusing to save tracked file: {name}. Use -f.")
            paths.append(path)
        for name, path in zip(names, paths):
            section.files[name] = repo.hash_blob(encrypt(path.read_bytes(), section.recipients))
    if not names:
        print("No files.")
        return
    repo.commit(ref, old_oid, parent, sections, message)


def parser_for_cli():
    epilog = """Requires Python 3.11+, git, and age. No Python packages are needed.

Examples:
  git vault init -r age1...
  git vault save -s production -m 'Rotate credentials' -- .env
  git vault restore -a < /path/to/identity
  git vault save -b vault-update -n -B origin/vault -- .env

Exit codes: 0 success; 1 operation failed; 2 invalid arguments; 3 ref conflict.
Plaintext exclusion is your responsibility; ignore settings are never modified.
"""
    parser = argparse.ArgumentParser(prog="git vault", description=__doc__,
                                     epilog=epilog,
                                     formatter_class=argparse.RawDescriptionHelpFormatter,
                                     allow_abbrev=False)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("version", help="Show the version.",
                        description="Print the hardcoded version and exit.",
                        allow_abbrev=False)
    skill = commands.add_parser(
        "skill", help="Print or install the git-vault agent skill.",
        description="Print SKILL.md to stdout, or write it to a file without requiring Git or age.",
        epilog="Examples:\n  git vault skill\n  git vault skill -o\n"
               "  git vault skill -o .claude/skills/git-vault/SKILL.md\n"
               "Relative output paths are resolved from the current directory; parent directories are created.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        allow_abbrev=False)
    skill.add_argument("-o", "--output", nargs="?", const=DEFAULT_SKILL_PATH, metavar="PATH",
                       help=f"Write SKILL.md to a file (default when PATH is omitted: {DEFAULT_SKILL_PATH}).")
    skill.add_argument("-f", "--force", action="store_true",
                       help="Overwrite an existing output file; requires -o.")

    def leaf(group, name, operation, description, section=False, update=False,
             create=False, identity=False, recipient=False):
        p = group.add_parser(name, description=description, help=description,
                             epilog=epilog, formatter_class=argparse.RawDescriptionHelpFormatter,
                             allow_abbrev=False)
        p.set_defaults(operation=operation)
        p.add_argument("-b", "--branch", metavar="NAME", help="Select a local branch (default: vault).")
        p.add_argument("-C", "--no-color", action="store_true", help="Disable ANSI colors.")
        if section:
            p.add_argument("-s", "--section", default="default", metavar="NAME",
                           help="Select a section (default: default).")
        if update:
            messages = p.add_mutually_exclusive_group()
            messages.add_argument("-m", "--message", action="append", metavar="TEXT",
                                  help="Set the commit message; repeat for paragraphs. Do not include secrets.")
            messages.add_argument("-F", "--message-file", metavar="PATH",
                                  help="Read a UTF-8 commit message from a file (not stdin).")
        if create:
            p.add_argument("-n", "--new-branch", action="store_true",
                           help="Create the explicitly named -b branch; fail if it exists.")
            p.add_argument("-B", "--base", metavar="REF",
                           help="Set the creation base (default: vault); requires -n.")
        if identity:
            p.add_argument("-i", "--identity", action="append", metavar="PATH",
                           help="Use an identity file; repeat for multiple files. Otherwise read stdin or prompt without echo.")
        if recipient:
            p.add_argument("-r", "--recipient", action="append", required=True, metavar="KEY",
                           help="Add a native age public key; repeat for multiple recipients.")
        return p

    leaf(commands, "init", "init", "Initialize an independent vault branch.",
         update=True, recipient=True)
    for name in ("sections", "recipients"):
        group_parser = commands.add_parser(name, help=f"Manage {name}.")
        group = group_parser.add_subparsers(dest="action", required=True)
        leaf(group, "list", name + "-list", f"List {name}.", section=name == "recipients")
        for action in ("add", "remove"):
            p = leaf(group, action, name + "-" + action, f"{action.capitalize()} {name}.",
                     section=name == "recipients", update=True, create=True,
                     identity=name == "recipients", recipient=name == "sections" and action == "add")
            if name == "sections":
                p.add_argument("name", metavar="NAME", help="Name the section.")
            else:
                p.add_argument("keys", nargs="+", metavar="KEY", help="Specify native age public keys.")
    leaf(commands, "list", "list", "List saved paths in a section.", section=True)
    for operation in ("save", "restore", "remove"):
        p = leaf(commands, operation, operation,
                 {"save": "Encrypt files and commit them without changing your checkout.",
                  "restore": "Decrypt files into the working tree.",
                  "remove": "Remove saved files from the current snapshot; keep plaintext and history."}[operation],
                 section=True, update=operation != "restore", create=operation != "restore",
                 identity=operation == "restore")
        if operation in ("save", "restore"):
            p.add_argument("-a", "--all", action="store_true", help="Use all saved paths in this section; excludes explicit paths.")
            p.add_argument("-f", "--force", action="store_true",
                           help=("Allow tracked input files. Existing plaintext and Git history are not removed."
                                 if operation == "save" else
                                 "Overwrite existing or tracked files, including uncommitted changes. The index is unchanged."))
        else:
            p.set_defaults(all=False)
        if operation == "restore":
            p.add_argument("-R", "--revision", metavar="REV", help="Restore from a reachable historical commit (default: branch tip).")
        p.add_argument("paths", nargs="*", metavar="PATH", help="Use paths relative to the current directory; use -- before leading hyphens.")
    return parser


def main():
    if sys.version_info < (3, 11):
        print("git-vault: Python 3.11 or later is required.", file=sys.stderr)
        return 1
    def interrupt(signum, frame):
        raise KeyboardInterrupt

    signal.signal(signal.SIGTERM, interrupt)
    parser = parser_for_cli()
    if len(sys.argv) == 1:
        parser.print_help()
        return 0
    args = parser.parse_args()
    if args.command == "version":
        print(VERSION)
        return 0
    if getattr(args, "new_branch", False) and args.branch is None:
        parser.error("--new-branch requires an explicit --branch")
    if getattr(args, "base", None) is not None and not args.new_branch:
        parser.error("--base requires --new-branch")
    if hasattr(args, "paths") and bool(args.paths) == bool(args.all):
        parser.error("specify file paths" if args.operation == "remove"
                     else "specify file paths or --all, exclusively")
    try:
        if args.command == "skill":
            output_skill(args)
        else:
            execute(args)
    except VaultError as error:
        print(f"git-vault: {error}", file=sys.stderr)
        return error.code
    except (OSError, UnicodeError) as error:
        print(f"git-vault: {error}", file=sys.stderr)
        return 1
    except (KeyboardInterrupt, EOFError):
        print("git-vault: Interrupted.", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
